{
  期货求魔交易系统 - 通达信主图叠加指标 (v8 - 加冷却去重)
  来源:  bilibili UP「期货求魔」9 集教学
  方法论详见 ../METHOD.md

  v8 改进: 加冷却去重
    同一波 setup 内, BUY_BASE / SELL_BASE / WARN 可能在相邻或相近几根 K
    线连续点火 (例如同一波回踩做出两个 NL pivot, 或 MA120 反复被穿越).
    v8 引入 COOL 冷却参数, 每类信号在 COOL 根 K 线内只显示第一次, 之后
    必须等冷却过完才能再次触发. 仓位代理 IN_LONG/IN_SHORT 也基于冷却后
    的信号计算, 更接近真实仓位行为.

  v7 -> v8 折中:
    COOL 默认 30 (~5min 周期 2.5 小时), 短到可以接连抓相邻 setup,
    长到能去掉同一 setup 内的连发. 若你的品种波动周期更长,
    把 COOL 调到 60 或 100.

  建议周期: 5 分钟 K 线
}

{ ===== 三条均线 ===== }
MA20:   MA(C, 20),  COLORWHITE,  LINETHICK1;
MA120:  MA(C, 120), COLORYELLOW, LINETHICK1;
MA250:  MA(C, 250), COLORMAGENTA,LINETHICK2;

{ ===== MA250 斜率 / 多空分界 ===== }
SLP_N := 10;
SLP   := (MA250 - REF(MA250, SLP_N)) / C;
SLP_E := 0.0001;
UPT := SLP > SLP_E;
DNT := SLP < -SLP_E;
RNG := NOT(UPT) AND NOT(DNT);

{ ===== Pivot 检测 (左右各 K 根的极值) ===== }
K := 3;
NEARP := 0.3;
PL := REF(LOW, K)  = LLV(LOW, 2*K+1);
PH := REF(HIGH, K) = HHV(HIGH, 2*K+1);
NL := PL AND ABS(REF(LOW, K)  - REF(MA250, K)) / REF(MA250, K) * 100 <= NEARP;
NH := PH AND ABS(REF(HIGH, K) - REF(MA250, K)) / REF(MA250, K) * 100 <= NEARP;

{ ===== 回踩类型区分 (5_03 原文核心区别) ===== }
{ NL_HELD: 回踩低点 >= MA250 (得到MA250支撑) -> Signal 1 理想型 }
{ NL_BROKE: 回踩低点 < MA250 (假突破) -> Signal 2 洗盘型 }
NL_HELD  := NL AND REF(LOW, K)  >= REF(MA250, K);
NL_BROKE := NL AND REF(LOW, K)  <  REF(MA250, K);
NH_HELD  := NH AND REF(HIGH, K) <= REF(MA250, K);
NH_BROKE := NH AND REF(HIGH, K) >  REF(MA250, K);

{ ===== 前期高/低: 回踩之前 20 根 K 线的极值 =====
  REF(HHV(HIGH, 20), K+1) = 回踩 (K 根前) 再往前 20 根的最高
  这就是讲解里 "突破前面的高点" 的那个高点
}
PRE_HIGH := REF(HHV(HIGH, 20), K + 1);
PRE_LOW  := REF(LLV(LOW,  20), K + 1);

{ ===== 入场信号 (v7: 严格只在趋势方向, 震荡观望) ===== }
{ Signal 1 理想型 + Signal 2 洗盘型 - 都要求 "突破前期高/低" }
LONG_S1 := NL_HELD  AND C > PRE_HIGH AND C > MA250 AND UPT;
LONG_S2 := NL_BROKE AND C > PRE_HIGH AND C > MA250 AND UPT;
BUY_RAW := LONG_S1 OR LONG_S2;

SHORT_S1 := NH_HELD  AND C < PRE_LOW AND C < MA250 AND DNT;
SHORT_S2 := NH_BROKE AND C < PRE_LOW AND C < MA250 AND DNT;
SELL_RAW := SHORT_S1 OR SHORT_S2;

{ ===== v8: 冷却去重 (同一 setup 内只显示第一次) ===== }
COOL := 30;
BUY_BASE  := BUY_RAW  AND COUNT(BUY_RAW,  COOL) = 1;
SELL_BASE := SELL_RAW AND COUNT(SELL_RAW, COOL) = 1;

{ ===== 出场基本事件 (5_04 三档移动平仓) ===== }
X_LONG_WARN  := CROSS(MA120, C);   { 跌破 MA120 -> 减仓警告 }
X_LONG_FULL  := CROSS(MA250, C);   { 跌破 MA250 -> 全平 }
X_SHORT_WARN := CROSS(C, MA120);
X_SHORT_FULL := CROSS(C, MA250);

{ ===== 仓位状态代理 (v7: MAX_HOLD 提到 1500 根 ~ 5min 周期 1 个月) ===== }
MAX_HOLD := 1500;
LAST_BUY  := BARSLAST(BUY_BASE);
LAST_END_LONG  := MIN(BARSLAST(X_LONG_FULL),  BARSLAST(SELL_BASE));
IN_LONG  := LAST_BUY  < LAST_END_LONG  AND LAST_BUY  <= MAX_HOLD;

LAST_SELL := BARSLAST(SELL_BASE);
LAST_END_SHORT := MIN(BARSLAST(X_SHORT_FULL), BARSLAST(BUY_BASE));
IN_SHORT := LAST_SELL < LAST_END_SHORT AND LAST_SELL <= MAX_HOLD;

EXIT_LONG_WARN_RAW  := X_LONG_WARN  AND IN_LONG;
EXIT_LONG_FULL      := X_LONG_FULL  AND IN_LONG;
EXIT_SHORT_WARN_RAW := X_SHORT_WARN AND IN_SHORT;
EXIT_SHORT_FULL     := X_SHORT_FULL AND IN_SHORT;

{ v8: 减仓警告也加冷却 (MA120 反复穿越) }
EXIT_LONG_WARN  := EXIT_LONG_WARN_RAW  AND COUNT(EXIT_LONG_WARN_RAW,  COOL) = 1;
EXIT_SHORT_WARN := EXIT_SHORT_WARN_RAW AND COUNT(EXIT_SHORT_WARN_RAW, COOL) = 1;

{ ===== 价差极端 (1 年最大价差近似 -> 全部止盈) ===== }
EXT_N := 1200;
SPD := C - MA250;
EXT_L_RAW := ABS(SPD) = HHV(ABS(SPD), EXT_N) AND SPD > 0 AND IN_LONG;
EXT_S_RAW := ABS(SPD) = HHV(ABS(SPD), EXT_N) AND SPD < 0 AND IN_SHORT;

{ v8: 极端价差也加冷却 (新高连续多根时去重) }
EXT_L := EXT_L_RAW AND COUNT(EXT_L_RAW, COOL) = 1;
EXT_S := EXT_S_RAW AND COUNT(EXT_S_RAW, COOL) = 1;

{ ===== 可视化: STICKLINE 短线 "指向" 对应 K 线 ===== }
{ 模式: 短线条紧贴 K 线一端, 标签在另一端, 一目了然指向哪根 K 线 }

{ 买入 (黄色 短线在 K 下方, "买"标签在更下方) }
STICKLINE(BUY_BASE, LOW * 0.997, LOW * 0.989, 2.0, 0), COLORYELLOW;
DRAWTEXT(BUY_BASE, LOW * 0.985, '买'), COLORYELLOW;

{ 卖出 (黄色 短线在 K 上方, "卖"标签在更上方) }
STICKLINE(SELL_BASE, HIGH * 1.003, HIGH * 1.011, 2.0, 0), COLORYELLOW;
DRAWTEXT(SELL_BASE, HIGH * 1.015, '卖'), COLORYELLOW;

{ 全平多 (青色 短线在 K 上方) }
STICKLINE(EXIT_LONG_FULL, HIGH * 1.002, HIGH * 1.008, 1.5, 0), COLORCYAN;
DRAWTEXT(EXIT_LONG_FULL, HIGH * 1.011, '平多'), COLORCYAN;

{ 全平空 (青色 短线在 K 下方) }
STICKLINE(EXIT_SHORT_FULL, LOW * 0.998, LOW * 0.992, 1.5, 0), COLORCYAN;
DRAWTEXT(EXIT_SHORT_FULL, LOW * 0.989, '平空'), COLORCYAN;

{ 减仓警告 (白色 细短线) }
STICKLINE(EXIT_LONG_WARN, HIGH * 1.002, HIGH * 1.005, 0.8, 0), COLORWHITE;
DRAWTEXT(EXIT_LONG_WARN, HIGH * 1.008, '减'), COLORWHITE;
STICKLINE(EXIT_SHORT_WARN, LOW * 0.998, LOW * 0.995, 0.8, 0), COLORWHITE;
DRAWTEXT(EXIT_SHORT_WARN, LOW * 0.992, '减'), COLORWHITE;

{ 极端价差 (紫色 中等短线) }
STICKLINE(EXT_L, HIGH * 1.005, HIGH * 1.013, 1.0, 0), COLORMAGENTA;
DRAWTEXT(EXT_L, HIGH * 1.017, '极'), COLORMAGENTA;
STICKLINE(EXT_S, LOW * 0.995, LOW * 0.987, 1.0, 0), COLORMAGENTA;
DRAWTEXT(EXT_S, LOW * 0.983, '极'), COLORMAGENTA;

{ ===== 趋势染色 (淡淡的) ===== }
STICKLINE(UPT AND NOT(BUY_BASE), LOW, LOW * 0.999, 0.5, 0), COLORRED;
STICKLINE(DNT AND NOT(SELL_BASE), HIGH, HIGH * 1.001, 0.5, 0), COLORGREEN;
